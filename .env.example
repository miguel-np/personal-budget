NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:3000,http://localhost:3000
ACTUAL_SERVER_URL=http://127.0.0.1:5006
# Must match the persistent path used by the Actual Compose volume.
ACTUAL_SERVER_DATA_DIR=./.local/actual-server-data
ACTUAL_BUDGET_ID=
ACTUAL_SERVER_PASSWORD=
ACTUAL_DATA_DIR=./.local/actual-api
BUDGET_CURRENCY=EUR
# Optional local-only assistant and conversational savings planner. AI stays off unless explicitly enabled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_ENABLED=false
# Hybrid category suggestions are separately opt-in. Requires AI_ENABLED=true and a local OLLAMA_MODEL.
AI_CATEGORY_CLASSIFICATION_ENABLED=false
# Payee/merchant label is the only transaction attribute sent to Ollama; set false to keep it local.
AI_CATEGORY_CLASSIFICATION_INCLUDE_PAYEE=true
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_CONTEXT_CHARS=4000
# Optional controlled web research. Off by default; each request still needs explicit UI consent.
# Default is a loopback SearXNG instance. Remote providers must use HTTPS.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BASE_URL=http://127.0.0.1:8080
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_QUERY_CHARS=300
WEB_SEARCH_MAX_RESPONSE_KB=128
# MCP runs over stdio only; it is not an HTTP listener.
MCP_ENABLED=false
AI_WRITE_OPERATIONS_ENABLED=false
# Backup scripts operate on the stopped Compose data directory.
BACKUP_RETENTION_DAYS=30

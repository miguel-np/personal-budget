NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:3000,http://localhost:3000
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_BUDGET_ID=
ACTUAL_SERVER_PASSWORD=
ACTUAL_DATA_DIR=./.local/actual-api
BUDGET_CURRENCY=EUR
# Optional local-only assistant. AI stays off unless explicitly enabled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_ENABLED=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_CONTEXT_CHARS=4000
# MCP runs over stdio only; it is not an HTTP listener.
MCP_ENABLED=false
AI_WRITE_OPERATIONS_ENABLED=false
# Backup scripts operate on the stopped Compose data directory.
BACKUP_RETENTION_DAYS=30

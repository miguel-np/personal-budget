# Plantilla documental de configuración. Los nombres finales deben mantenerse
# sincronizados con la implementación cuando se cree el código.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info

# Actual Budget: URL local del servidor. No es una API REST; el adaptador
# de Node.js debe utilizar @actual-app/api y seguir sus instrucciones oficiales.
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_BUDGET_ID=
ACTUAL_SERVER_PASSWORD=
ACTUAL_DATA_DIR=./.local/actual-api

# Ollama local. No reemplazar por una URL alojada en la nube si se requiere
# privacidad local estricta.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Seguridad y comportamiento
AI_ENABLED=true
MCP_ENABLED=true
AI_WRITE_OPERATIONS_ENABLED=false
CHAT_HISTORY_PERSISTENCE=disabled
MAX_IMPORT_FILE_MB=25
MAX_CHAT_TOOL_CALLS=8

# Los valores reales se guardan en .env, que debe permanecer fuera de Git.

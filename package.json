{
  "name": "personal-budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal finance web application",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.6.0"
  },
  "workspaces": [
    "packages/finance-core",
    "services/actual-adapter",
    "services/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace=@personal-budget/finance-core && npm run build --workspace=@personal-budget/actual-adapter && npm run build --workspace=@personal-budget/api && npm run build --workspace=@personal-budget/web",
    "typecheck": "npm run build --workspace=@personal-budget/finance-core && npm run build --workspace=@personal-budget/actual-adapter && npm run typecheck --workspace=@personal-budget/api && npm run typecheck --workspace=@personal-budget/web && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "dev:api": "npm run build --workspace=@personal-budget/finance-core && npm run build --workspace=@personal-budget/actual-adapter && npm run dev --workspace=@personal-budget/api",
    "dev:web": "npm run dev --workspace=@personal-budget/web",
    "backup:actual": "tsx scripts/actual-backup.ts backup",
    "restore:actual": "tsx scripts/actual-backup.ts restore",
    "mcp:serve": "node services/mcp/server.mjs",
    "test:ollama:acceptance": "vitest run services/api/tests/local-ai-live-acceptance.test.ts",
    "start": "npm run build && node scripts/local-runtime.mjs",
    "start:local": "npm run build && node scripts/local-runtime.mjs",
    "start:built": "node scripts/local-runtime.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "@fastify/helmet": "13.2.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
